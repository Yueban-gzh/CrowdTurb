{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "archflow/scene_schema_v0.1",
  "title": "ArchFlow AI 场景数据格式 v0.1（A 模块权威格式）",
  "description": "成员 A（初始场配置）产出、全组共用的场景文件格式。坐标约定：单位为米，原点在场地左下角，x 向右，y 向上。人群按『分布（区域+人数）』描述，不存个体列表；C 如需 agent 对比实验，自行从分布采样个体。",
  "type": "object",
  "required": ["version", "meta", "geometry", "exits", "crowd", "params"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "0.1",
      "description": "格式版本号，接口变化必须升版本并组内确认"
    },
    "meta": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "description": "场景名称，如：示例体育馆" },
        "author": { "type": "string", "description": "创建者" },
        "created": { "type": "string", "description": "创建时间 ISO8601" },
        "notes": { "type": "string", "description": "备注" }
      }
    },
    "geometry": {
      "type": "object",
      "required": ["size", "resolution"],
      "properties": {
        "size": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "description": "场地 [长L(x方向), 宽H(y方向)]，单位米"
        },
        "resolution": {
          "type": "number", "exclusiveMinimum": 0,
          "description": "栅格分辨率（米/格）。默认 0.5；决定 C 的计算网格与 FNO 输入尺寸"
        },
        "walls": {
          "type": "array",
          "items": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": { "type": "number" }
          },
          "description": "内部隔墙线段 [x1,y1,x2,y2]。v0.1 示例为空；第 3 周『可调整通道』启用"
        },
        "obstacles": {
          "type": "array",
          "description": "内部障碍（舞台、器材室等），轴对齐矩形",
          "items": {
            "type": "object",
            "required": ["name", "x", "y", "w", "h"],
            "properties": {
              "name": { "type": "string", "description": "障碍名称" },
              "x": { "type": "number", "description": "矩形左下角 x" },
              "y": { "type": "number", "description": "矩形左下角 y" },
              "w": { "type": "number", "exclusiveMinimum": 0, "description": "宽（x方向，米）" },
              "h": { "type": "number", "exclusiveMinimum": 0, "description": "高（y方向，米）" }
            }
          }
        }
      }
    },
    "exits": {
      "type": "array",
      "description": "出口。v0.1 出口只允许开在外边界墙上；side + offset 定位，width 为开口宽度",
      "items": {
        "type": "object",
        "required": ["id", "name", "side", "offset", "width"],
        "properties": {
          "id": { "type": "string", "description": "出口唯一 ID，如 E1" },
          "name": { "type": "string", "description": "显示名，如 南侧主出口" },
          "side": { "enum": ["N", "S", "E", "W"], "description": "在哪面墙：N=y=H 北墙，S=y=0 南墙，E=x=L 东墙，W=x=0 西墙" },
          "offset": {
            "type": "number",
            "description": "开口起点沿墙的偏移量（米）。N/S 墙从 x=0 起量，E/W 墙从 y=0 起量"
          },
          "width": { "type": "number", "exclusiveMinimum": 0, "description": "开口宽度（米）。D 的核心可调参数之一" }
        }
      }
    },
    "crowd": {
      "type": "object",
      "required": ["zones"],
      "properties": {
        "zones": {
          "type": "array",
          "description": "初始人群分布。区域为任意多边形（编辑器 v0.1 只产出轴对齐矩形）。栅格化后区域内均匀分布 count 人",
          "items": {
            "type": "object",
            "required": ["id", "name", "polygon", "count"],
            "properties": {
              "id": { "type": "string", "description": "区域唯一 ID，如 Z1" },
              "name": { "type": "string", "description": "显示名，如 看台西侧" },
              "polygon": {
                "type": "array", "minItems": 3,
                "items": {
                  "type": "array", "minItems": 2, "maxItems": 2,
                  "items": { "type": "number" }
                },
                "description": "多边形顶点 [[x,y], ...]，单位米"
              },
              "count": { "type": "number", "exclusiveMinimum": 0, "description": "区域内人数" },
              "profile": {
                "enum": ["seated", "standing"],
                "description": "人群类型：seated=坐席（看台），standing=站立/流动。留给 C/D 做参数区分用"
              }
            }
          }
        }
      }
    },
    "params": {
      "type": "object",
      "required": ["walk_speed", "T"],
      "properties": {
        "walk_speed": { "type": "number", "exclusiveMinimum": 0, "description": "自由步行速度 m/s，默认 1.2" },
        "T": { "type": "number", "exclusiveMinimum": 0, "description": "仿真总时长（秒）" },
        "dt": { "type": "number", "exclusiveMinimum": 0, "description": "（可选）建议时间步长（秒），供 C 参考" },
        "jam_density": { "type": "number", "exclusiveMinimum": 0, "description": "（可选）拥堵密度阈值 人/m²，默认 4.0，D 的拥堵指标可参考" }
      }
    }
  }
}
