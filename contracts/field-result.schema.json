{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrowdTurb field result draft 0.1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "result_id", "scene_id", "scene_revision", "source", "description", "frames", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "result_id": {"type": "string", "minLength": 1},
    "scene_id": {"type": "string", "minLength": 1},
    "scene_revision": {"type": "integer", "minimum": 1},
    "source": {"enum": ["mock", "pde", "fno"]},
    "description": {"type": "string", "minLength": 1},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["generator", "reproducibility_record"], "properties": {"generator": {"type": "string", "minLength": 1}, "reproducibility_record": {"type": ["string", "null"], "minLength": 1}}},
    "frames": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["time_s", "density", "velocity"],
        "properties": {
          "time_s": {"type": "number", "minimum": 0},
          "density": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}}},
          "velocity": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false, "minItems": 2}}}
        }
      }
    }
  },
  "allOf": [{"if": {"properties": {"source": {"enum": ["pde", "fno"]}}}, "then": {"properties": {"provenance": {"properties": {"reproducibility_record": {"type": "string", "minLength": 1}}}}}}]
}
