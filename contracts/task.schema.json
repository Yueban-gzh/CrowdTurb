{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrowdTurb task draft 0.1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "task_id", "scene_id", "scene_revision", "source", "status", "result_id", "error"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "scene_id": {"type": "string", "minLength": 1},
    "scene_revision": {"type": "integer", "minimum": 1},
    "source": {"enum": ["mock", "pde", "fno"]},
    "status": {"enum": ["queued", "running", "succeeded", "failed"]},
    "result_id": {"type": ["string", "null"], "minLength": 1},
    "error": {"type": ["object", "null"], "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "succeeded"}}}, "then": {"properties": {"result_id": {"type": "string"}, "error": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "failed"}}}, "then": {"properties": {"result_id": {"type": "null"}, "error": {"type": "object"}}}},
    {"if": {"properties": {"status": {"enum": ["queued", "running"]}}}, "then": {"properties": {"result_id": {"type": "null"}, "error": {"type": "null"}}}}
  ]
}
