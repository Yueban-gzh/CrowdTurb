{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrowdTurb trajectory-derived field proposal 0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_id",
    "scene_revision",
    "input_hash",
    "initial_state_hash",
    "source",
    "model_sha256",
    "simulation_settings",
    "reproducibility_record",
    "result_id",
    "derived_from",
    "grid",
    "walkable",
    "frames",
    "method",
    "density_estimator"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_revision": {
      "type": "integer",
      "minimum": 1
    },
    "input_hash": {
      "$ref": "#/$defs/hash"
    },
    "initial_state_hash": {
      "$ref": "#/$defs/hash"
    },
    "source": {
      "enum": [
        "mock",
        "stddn"
      ]
    },
    "model_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "simulation_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dt_s",
        "seed",
        "integrator",
        "planner_version",
        "collision_version"
      ],
      "properties": {
        "dt_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "integrator": {
          "type": "string",
          "minLength": 1
        },
        "planner_version": {
          "type": "string",
          "minLength": 1
        },
        "collision_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reproducibility_record": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "derived_from": {
      "type": "string",
      "minLength": 1
    },
    "grid": {
      "$ref": "#/$defs/grid"
    },
    "walkable": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "boolean"
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "time_s",
          "density",
          "velocity"
        ],
        "properties": {
          "time_s": {
            "type": "number",
            "minimum": 0
          },
          "density": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "velocity": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2
              }
            }
          }
        }
      }
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "density_estimator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "bandwidth_m",
        "support_sigma",
        "boundary",
        "version"
      ],
      "properties": {
        "method": {
          "enum": [
            "cell",
            "gaussian_visible"
          ]
        },
        "bandwidth_m": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "support_sigma": {
          "enum": [
            null,
            3.0
          ]
        },
        "boundary": {
          "enum": [
            "whole_walkable_cell",
            "visible_walkable_centers_per_person_normalization"
          ]
        },
        "version": {
          "const": "1"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "cell"
              }
            }
          },
          "then": {
            "properties": {
              "bandwidth_m": {
                "type": "null"
              },
              "support_sigma": {
                "type": "null"
              },
              "boundary": {
                "const": "whole_walkable_cell"
              }
            }
          },
          "else": {
            "properties": {
              "bandwidth_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "support_sigma": {
                "const": 3.0
              },
              "boundary": {
                "const": "visible_walkable_centers_per_person_normalization"
              }
            }
          }
        }
      ]
    },
    "behavior_hash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "vector": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nx",
        "ny",
        "dx",
        "dy",
        "origin"
      ],
      "properties": {
        "nx": {
          "type": "integer",
          "minimum": 1
        },
        "ny": {
          "type": "integer",
          "minimum": 1
        },
        "dx": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dy": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "origin": {
          "$ref": "#/$defs/vector"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "stddn"
          }
        }
      },
      "then": {
        "properties": {
          "model_sha256": {
            "$ref": "#/$defs/hash"
          },
          "reproducibility_record": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
